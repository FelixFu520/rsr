#!/usr/bin/env bash
# 用 Isaac Sim python.sh 跑 rsr CLI。仓库根: ./scripts/rsr collect run -c configs/tabletop.toml
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ISAAC_HOME="${RSR_ISAACSIM_HOME:-$ROOT/app}"
PYTHON_SH="$ISAAC_HOME/python.sh"
export RSR_ASSETS_ROOT="${RSR_ASSETS_ROOT:-$ROOT/assets}"

if [[ ! -x "$PYTHON_SH" ]]; then
  echo "找不到 Isaac python.sh: $PYTHON_SH" >&2
  echo "请在仓库根创建 app -> isaacsim 符号链接，或设置 RSR_ISAACSIM_HOME。" >&2
  exit 1
fi

exec "$PYTHON_SH" -m real2sim2real.core.cli "$@"
